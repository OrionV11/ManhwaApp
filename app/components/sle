import React from "react";
import { TouchableOpacity, View, Text, Image, StyleSheet } from "react";
import { useRouter } from "expo-router";

export type Manhwa = {
	id: string | number;
	title: string
	coverImage?: string;
	score?: number;
	type?: string;
	year?: number;
	shortDescription?: string;
};


export default function ManhwaCard({ item }: { item: ManhwaItem }) {
	const router = useRouter();

	const onPress = () => {
	// navigate to /media/<id>
		router.push('/media/${item.id}');
	};

	return (
		<TouchableOpacity onPress={onPress} style={styles.card}>
			<Image
				source={
					item.coverImage ? { uri: item.coverImage } : require("../assests/placeholder.png")
				}
				style={styles.image}
				resizeMode="cover"
				/>
			<View style={styles.content}>
				<Text numberOfLines={2} style={styles.title}>
					{item.title}
				</Text>
</>
);
				
